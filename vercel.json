{
  "version": 2,
  "regions": [
    "gru1"
  ],
  "builds": [
    {
      "src": "api/personal-session.mjs",
      "use": "@vercel/node"
    },
    {
      "src": "api/team-drive-callback.mjs",
      "use": "@vercel/node"
    },
    {
      "src": "api/team-drive-authorize.mjs",
      "use": "@vercel/node"
    },
    {
      "src": "api/team-reports.mjs",
      "use": "@vercel/node"
    },
    {
      "src": "api/team.mjs",
      "use": "@vercel/node"
    },
    {
      "src": "cloud-server.mjs",
      "use": "@vercel/node"
    },
    {
      "src": "technical-review-server.mjs",
      "use": "@vercel/node"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "*.js",
      "use": "@vercel/static"
    },
    {
      "src": "PDF-LIB-LICENSE.md",
      "use": "@vercel/static"
    },
    {
      "src": "*.png",
      "use": "@vercel/static"
    },
    {
      "src": "manifest.webmanifest",
      "use": "@vercel/static"
    },
    {
      "src": "*.css",
      "use": "@vercel/static"
    },
    {
      "src": "team-merge.mjs",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/personal-session",
      "dest": "/api/personal-session.mjs"
    },
    {
      "src": "/sw.js",
      "headers": {
        "Cache-Control": "no-cache",
        "Service-Worker-Allowed": "/"
      },
      "continue": true
    },
    {
      "src": "/api/team-drive-callback",
      "dest": "/api/team-drive-callback.mjs"
    },
    {
      "src": "/api/team-drive-authorize",
      "dest": "/api/team-drive-authorize.mjs"
    },
    {
      "src": "/api/team-reports",
      "dest": "/api/team-reports.mjs"
    },
    {
      "src": "/api/team",
      "dest": "/api/team.mjs"
    },
    {
      "src": "/api/cloud",
      "dest": "/cloud-server.mjs"
    },
    {
      "src": "/api/technical-review",
      "dest": "/technical-review-server.mjs"
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "status": 404
    }
  ]
}
