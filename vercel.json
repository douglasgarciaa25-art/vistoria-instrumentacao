{
  "version": 2,
  "regions": [
    "gru1"
  ],
  "builds": [
    {
      "src": "api/weekly-sheet.mjs",
      "use": "@vercel/node"
    },
    {
      "src": "api/team-trash-retention.mjs",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 60
      }
    },
    {
      "src": "api/team-events.mjs",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 60
      }
    },
    {
      "src": "api/pdf-preview-assets.mjs",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "node_modules/pdfjs-dist/legacy/build/pdf.min.mjs",
          "node_modules/pdfjs-dist/legacy/build/pdf.worker.min.mjs",
          "node_modules/pdfjs-dist/LICENSE",
          "node_modules/pdfjs-dist/package.json"
        ]
      }
    },
    {
      "src": "api/personal-session.mjs",
      "use": "@vercel/node"
    },
    {
      "src": "api/team-drive-callback.mjs",
      "use": "@vercel/node"
    },
    {
      "src": "api/team-drive-authorize.mjs",
      "use": "@vercel/node"
    },
    {
      "src": "api/team-reports.mjs",
      "use": "@vercel/node"
    },
    {
      "src": "api/team.mjs",
      "use": "@vercel/node"
    },
    {
      "src": "cloud-server.mjs",
      "use": "@vercel/node"
    },
    {
      "src": "technical-review-server.mjs",
      "use": "@vercel/node"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "*.js",
      "use": "@vercel/static"
    },
    {
      "src": "PDF-LIB-LICENSE.md",
      "use": "@vercel/static"
    },
    {
      "src": "*.png",
      "use": "@vercel/static"
    },
    {
      "src": "manifest.webmanifest",
      "use": "@vercel/static"
    },
    {
      "src": "*.css",
      "use": "@vercel/static"
    },
    {
      "src": "team-merge.mjs",
      "use": "@vercel/static"
    },
    {
      "src": "vistoria-logo.svg",
      "use": "@vercel/static"
    },
    {
      "src": "team-live.mjs",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/weekly-sheet",
      "dest": "/api/weekly-sheet.mjs"
    },
    {
      "src": "/api/team-trash-retention",
      "dest": "/api/team-trash-retention.mjs"
    },
    {
      "src": "/api/team-events",
      "dest": "/api/team-events.mjs"
    },
    {
      "src": "/pdf-preview-assets/5.4.624/engine\\.mjs",
      "dest": "/api/pdf-preview-assets.mjs?asset=engine"
    },
    {
      "src": "/pdf-preview-assets/5.4.624/worker\\.mjs",
      "dest": "/api/pdf-preview-assets.mjs?asset=worker"
    },
    {
      "src": "/pdf-preview-assets/5.4.624/license\\.txt",
      "dest": "/api/pdf-preview-assets.mjs?asset=license"
    },
    {
      "src": "/api/personal-session",
      "dest": "/api/personal-session.mjs"
    },
    {
      "src": "/sw.js",
      "headers": {
        "Cache-Control": "no-cache",
        "Service-Worker-Allowed": "/"
      },
      "continue": true
    },
    {
      "src": "/api/team-drive-callback",
      "dest": "/api/team-drive-callback.mjs"
    },
    {
      "src": "/api/team-drive-authorize",
      "dest": "/api/team-drive-authorize.mjs"
    },
    {
      "src": "/api/team-reports",
      "dest": "/api/team-reports.mjs"
    },
    {
      "src": "/api/team",
      "dest": "/api/team.mjs"
    },
    {
      "src": "/api/cloud",
      "dest": "/cloud-server.mjs"
    },
    {
      "src": "/api/technical-review",
      "dest": "/technical-review-server.mjs"
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "status": 404
    }
  ],
  "crons": [
    {
      "path": "/api/team-trash-retention",
      "schedule": "0 6 * * *"
    }
  ]
}
